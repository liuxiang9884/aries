#!/usr/bin/env python3
"""Pull files from Synology File Station over HTTPS.

The tool uses only Python's standard library. Passwords are read interactively
or from a mode-0600 password file and are never written to disk by this tool.
"""

from __future__ import annotations

import argparse
import datetime as dt
import getpass
import json
import os
import posixpath
import re
import ssl
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Iterator


SESSION_NAME = "FileStation"
CHUNK_SIZE = 1024 * 1024
DEFAULT_DATE_REGEX = r"(?:^|_)(\d{8})(?:[_.]|$)"

COMMON_ERRORS = {
    100: "Unknown error",
    101: "Invalid API parameter",
    102: "Requested API does not exist",
    103: "Requested API method does not exist",
    104: "Requested API version is unsupported",
    105: "Insufficient user privilege",
    106: "Session timeout",
    107: "Session interrupted by duplicate login",
    119: "SID not found",
    400: "No such account or incorrect password",
    401: "Account disabled",
    402: "Permission denied",
    403: "Two-step verification code required",
    404: "Failed to authenticate two-step verification code",
}


class SynologyError(RuntimeError):
    """Base exception for Synology API failures."""


class SynologyAPIError(SynologyError):
    def __init__(self, code: int, details: Any = None):
        self.code = code
        self.details = details
        message = COMMON_ERRORS.get(code, f"Synology API error {code}")
        if details:
            message = f"{message}: {details}"
        super().__init__(message)


def normalize_base_url(value: str) -> str:
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme.lower() != "https" or not parsed.netloc:
        raise ValueError("NAS URL must be a complete https:// URL")
    if parsed.query or parsed.fragment:
        raise ValueError("NAS URL must not contain a query string or fragment")
    path = parsed.path.rstrip("/")
    return urllib.parse.urlunsplit(
        (parsed.scheme.lower(), parsed.netloc, path, "", "")
    )


def normalize_remote_path(value: str) -> str:
    if "\0" in value or not value.startswith("/"):
        raise ValueError("Remote path must start with '/'")
    normalized = posixpath.normpath(value)
    if normalized == "/" or normalized.startswith("/../"):
        raise ValueError("Remote path must start with a shared-folder name")
    return normalized


def safe_child_path(base: Path, name: str) -> Path:
    if name in ("", ".", "..") or "/" in name or "\0" in name:
        raise ValueError(f"Unsafe remote file name: {name!r}")
    candidate = base / name
    try:
        candidate.resolve(strict=False).relative_to(base.resolve(strict=False))
    except ValueError as exc:
        raise ValueError(f"Destination escapes output directory: {name!r}") from exc
    return candidate


def should_skip(path: Path, *, size: int, mtime: int) -> bool:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return False
    return stat.S_ISREG(info.st_mode) and info.st_size == size


def read_password_file(path: Path) -> str:
    info = path.stat()
    if stat.S_IMODE(info.st_mode) & 0o077:
        raise PermissionError(
            f"Password file {path} must have mode 0600 (or stricter)"
        )
    password = path.read_text(encoding="utf-8")
    if password.endswith("\n"):
        password = password[:-1]
        if password.endswith("\r"):
            password = password[:-1]
    if not password:
        raise ValueError(f"Password file {path} is empty")
    return password


class SynologyClient:
    def __init__(self, base_url: str, *, timeout: float = 60.0):
        self.base_url = normalize_base_url(base_url)
        self.timeout = timeout
        self.sid: str | None = None
        self.api_info: dict[str, dict[str, Any]] = {}
        self.ssl_context = ssl.create_default_context()

    def _endpoint(self, path: str) -> str:
        return f"{self.base_url}/webapi/{path.lstrip('/')}"

    def _decode_json_response(self, response: Any) -> dict[str, Any]:
        raw = response.read()
        try:
            payload = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise SynologyError("NAS returned a non-JSON API response") from exc
        if not payload.get("success"):
            error = payload.get("error") or {}
            raise SynologyAPIError(int(error.get("code", -1)), error.get("errors"))
        return payload

    def _json_post(self, endpoint: str, params: dict[str, Any]) -> dict[str, Any]:
        encoded = urllib.parse.urlencode(params).encode("utf-8")
        request = urllib.request.Request(
            self._endpoint(endpoint),
            data=encoded,
            headers={
                "Accept": "application/json",
                "Content-Type": "application/x-www-form-urlencoded",
                "User-Agent": "synology-pull/1.0",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(
                request, timeout=self.timeout, context=self.ssl_context
            ) as response:
                return self._decode_json_response(response)
        except urllib.error.HTTPError as exc:
            try:
                return self._decode_json_response(exc)
            except SynologyError:
                raise
            except Exception as nested:
                raise SynologyError(f"HTTP {exc.code} from NAS") from nested
        except urllib.error.URLError as exc:
            raise SynologyError(f"Cannot connect to NAS: {exc.reason}") from exc

    def probe(self) -> dict[str, dict[str, Any]]:
        payload = self._json_post(
            "query.cgi",
            {
                "api": "SYNO.API.Info",
                "version": 1,
                "method": "query",
                "query": ",".join(
                    (
                        "SYNO.API.Auth",
                        "SYNO.FileStation.List",
                        "SYNO.FileStation.Download",
                    )
                ),
            },
        )
        data = payload.get("data") or {}
        required = {
            "SYNO.API.Auth",
            "SYNO.FileStation.List",
            "SYNO.FileStation.Download",
        }
        missing = required.difference(data)
        if missing:
            raise SynologyError(
                f"NAS does not expose required APIs: {', '.join(sorted(missing))}"
            )
        self.api_info = data
        return data

    def _api_params(
        self, api: str, method: str, params: dict[str, Any]
    ) -> tuple[str, dict[str, Any]]:
        if not self.api_info:
            self.probe()
        info = self.api_info[api]
        request_params: dict[str, Any] = {
            "api": api,
            "version": int(info["maxVersion"]),
            "method": method,
        }
        request_params.update(params)
        if self.sid:
            request_params["_sid"] = self.sid
        return str(info["path"]), request_params

    def call(self, api: str, method: str, **params: Any) -> dict[str, Any]:
        endpoint, request_params = self._api_params(api, method, params)
        return self._json_post(endpoint, request_params)

    def login(self, username: str, password: str, otp_code: str | None = None) -> None:
        if not self.api_info:
            self.probe()
        params: dict[str, Any] = {
            "account": username,
            "passwd": password,
            "session": SESSION_NAME,
            "format": "sid",
        }
        if otp_code:
            params["otp_code"] = otp_code
        payload = self.call("SYNO.API.Auth", "login", **params)
        sid = (payload.get("data") or {}).get("sid")
        if not sid:
            raise SynologyError("Login succeeded but the NAS returned no session ID")
        self.sid = str(sid)

    def logout(self) -> None:
        if not self.sid:
            return
        try:
            self.call("SYNO.API.Auth", "logout", session=SESSION_NAME)
        finally:
            self.sid = None

    def list_shares(self) -> list[dict[str, Any]]:
        payload = self.call(
            "SYNO.FileStation.List",
            "list_share",
            offset=0,
            limit=0,
            additional=json.dumps(["time", "perm"]),
        )
        return list((payload.get("data") or {}).get("shares") or [])

    def list_dir(self, remote_path: str) -> list[dict[str, Any]]:
        remote_path = normalize_remote_path(remote_path)
        files: list[dict[str, Any]] = []
        offset = 0
        while True:
            payload = self.call(
                "SYNO.FileStation.List",
                "list",
                folder_path=remote_path,
                offset=offset,
                limit=1000,
                sort_by="name",
                sort_direction="asc",
                filetype="all",
                additional=json.dumps(["size", "time"]),
            )
            data = payload.get("data") or {}
            batch = list(data.get("files") or [])
            files.extend(batch)
            offset += len(batch)
            if not batch or offset >= int(data.get("total", offset)):
                break
        return files

    def get_info(self, remote_path: str) -> dict[str, Any]:
        remote_path = normalize_remote_path(remote_path)
        payload = self.call(
            "SYNO.FileStation.List",
            "getinfo",
            path=json.dumps([remote_path]),
            additional=json.dumps(["size", "time"]),
        )
        files = list((payload.get("data") or {}).get("files") or [])
        if len(files) != 1:
            raise SynologyError(f"Remote path not found: {remote_path}")
        return files[0]

    def _download_request(
        self, remote_path: str, *, start: int = 0
    ) -> urllib.request.Request:
        endpoint, params = self._api_params(
            "SYNO.FileStation.Download",
            "download",
            {
                "path": json.dumps([normalize_remote_path(remote_path)]),
                "mode": "download",
            },
        )
        headers = {
            "Accept": "application/octet-stream",
            "User-Agent": "synology-pull/1.0",
        }
        if start:
            headers["Range"] = f"bytes={start}-"
        return urllib.request.Request(
            self._endpoint(endpoint)
            + "?"
            + urllib.parse.urlencode(params),
            headers=headers,
            method="GET",
        )

    def download_file(
        self,
        remote_path: str,
        local_path: Path,
        *,
        size: int,
        mtime: int,
    ) -> str:
        if local_path.is_symlink():
            raise SynologyError(f"Refusing to overwrite symlink: {local_path}")
        if should_skip(local_path, size=size, mtime=mtime):
            return "skipped"

        local_path.parent.mkdir(parents=True, exist_ok=True)
        partial = local_path.with_name(local_path.name + ".part")
        try:
            partial_info = partial.lstat()
        except FileNotFoundError:
            start = 0
        else:
            if stat.S_ISLNK(partial_info.st_mode):
                raise SynologyError(f"Refusing to use partial symlink: {partial}")
            if not stat.S_ISREG(partial_info.st_mode):
                raise SynologyError(f"Partial path is not a regular file: {partial}")
            start = partial_info.st_size
        if start > size:
            partial.unlink()
            start = 0
        elif start == size:
            os.replace(partial, local_path)
            os.utime(local_path, (mtime, mtime))
            return "downloaded"

        request = self._download_request(remote_path, start=start)
        try:
            response = urllib.request.urlopen(
                request, timeout=self.timeout, context=self.ssl_context
            )
        except urllib.error.HTTPError as exc:
            try:
                payload = self._decode_json_response(exc)
            except SynologyAPIError:
                raise
            except SynologyError:
                raise SynologyError(
                    f"Download failed for {remote_path}: HTTP {exc.code}"
                ) from exc
            raise SynologyError(f"Unexpected download response: {payload}") from exc
        except urllib.error.URLError as exc:
            raise SynologyError(f"Cannot download {remote_path}: {exc.reason}") from exc

        with response:
            content_type = response.headers.get_content_type()
            if content_type == "application/json":
                self._decode_json_response(response)
                raise SynologyError(f"NAS returned no content for {remote_path}")

            status = getattr(response, "status", response.getcode())
            append = start > 0 and status == 206
            if append:
                content_range = response.headers.get("Content-Range", "")
                if not content_range.startswith(f"bytes {start}-"):
                    raise SynologyError(
                        f"Invalid resume response for {remote_path}: {content_range}"
                    )
            mode = "ab" if append else "wb"
            with partial.open(mode) as output:
                while True:
                    chunk = response.read(CHUNK_SIZE)
                    if not chunk:
                        break
                    output.write(chunk)

        actual_size = partial.stat().st_size
        if actual_size != size:
            raise SynologyError(
                f"Incomplete download for {remote_path}: "
                f"expected {size} bytes, received {actual_size}"
            )
        os.replace(partial, local_path)
        os.utime(local_path, (mtime, mtime))
        return "downloaded"


def file_metadata(item: dict[str, Any]) -> tuple[int, int]:
    additional = item.get("additional") or {}
    size = int(additional.get("size", 0))
    times = additional.get("time") or {}
    mtime = int(times.get("mtime", 0))
    return size, mtime


def parse_yyyymmdd(value: str, field_name: str) -> str:
    if not re.fullmatch(r"\d{8}", value):
        raise ValueError(f"{field_name} must use YYYYMMDD format")
    try:
        parsed = dt.datetime.strptime(value, "%Y%m%d")
    except ValueError as exc:
        raise ValueError(f"{field_name} is not a valid calendar date: {value}") from exc
    return parsed.strftime("%Y%m%d")


def compile_date_regex(value: str) -> re.Pattern[str]:
    pattern = re.compile(value)
    if pattern.groups < 1:
        raise ValueError("Date regex must include a capture group for YYYYMMDD")
    return pattern


def matches_date_filter(
    name: str,
    *,
    start_date: str | None,
    end_date: str | None,
    date_regex: re.Pattern[str],
) -> bool:
    if start_date is None and end_date is None:
        return True
    match = date_regex.search(name)
    if match is None:
        return False
    file_date = parse_yyyymmdd(match.group(1), f"date extracted from {name}")
    if start_date is not None and file_date < start_date:
        return False
    if end_date is not None and file_date > end_date:
        return False
    return True


def iter_tree(
    client: SynologyClient, remote_root: str
) -> Iterator[tuple[dict[str, Any], str]]:
    stack: list[tuple[dict[str, Any], str]] = [(client.get_info(remote_root), "")]
    while stack:
        item, relative = stack.pop()
        yield item, relative
        if item.get("isdir"):
            children = client.list_dir(str(item["path"]))
            for child in reversed(children):
                name = str(child["name"])
                child_relative = posixpath.join(relative, name) if relative else name
                stack.append((child, child_relative))


def pull(
    client: SynologyClient,
    remote_path: str,
    local_path: Path,
    *,
    start_date: str | None = None,
    end_date: str | None = None,
    date_regex: re.Pattern[str] | None = None,
) -> tuple[int, int]:
    remote_path = normalize_remote_path(remote_path)
    root_info = client.get_info(remote_path)
    downloaded = 0
    skipped = 0
    date_regex = date_regex or compile_date_regex(DEFAULT_DATE_REGEX)

    if not root_info.get("isdir"):
        if not matches_date_filter(
            str(root_info["name"]),
            start_date=start_date,
            end_date=end_date,
            date_regex=date_regex,
        ):
            return 0, 0
        target = (
            safe_child_path(local_path, str(root_info["name"]))
            if local_path.is_dir()
            else local_path
        )
        size, mtime = file_metadata(root_info)
        print(f"GET  {remote_path} -> {target}", flush=True)
        result = client.download_file(
            remote_path, target, size=size, mtime=mtime
        )
        print(f"{'SKIP' if result == 'skipped' else 'OK  '} {target}", flush=True)
        return (0, 1) if result == "skipped" else (1, 0)

    local_path.mkdir(parents=True, exist_ok=True)
    for item, relative in iter_tree(client, remote_path):
        if relative == "":
            continue
        parts = relative.split("/")
        target = local_path
        for part in parts:
            target = safe_child_path(target, part)
        if item.get("isdir"):
            if target.is_symlink():
                raise SynologyError(f"Refusing to traverse symlink: {target}")
            target.mkdir(parents=True, exist_ok=True)
            continue
        if not matches_date_filter(
            str(item["name"]),
            start_date=start_date,
            end_date=end_date,
            date_regex=date_regex,
        ):
            continue

        size, mtime = file_metadata(item)
        if should_skip(target, size=size, mtime=mtime):
            print(f"SKIP {target}", flush=True)
            skipped += 1
            continue
        print(f"GET  {item['path']} -> {target}", flush=True)
        client.download_file(str(item["path"]), target, size=size, mtime=mtime)
        print(f"OK   {target} ({size} bytes)", flush=True)
        downloaded += 1
    return downloaded, skipped


def build_parser() -> argparse.ArgumentParser:
    default_url = os.environ.get("SYNOLOGY_URL")
    parser = argparse.ArgumentParser(
        prog="synology-pull",
        description="List and incrementally download Synology File Station data.",
    )
    parser.add_argument(
        "--url",
        default=default_url,
        required=default_url is None,
        help="DSM HTTPS base URL (or set SYNOLOGY_URL)",
    )
    parser.add_argument(
        "--user",
        default=os.environ.get("SYNOLOGY_USER", getpass.getuser()),
        help="DSM user name (default: current user)",
    )
    parser.add_argument(
        "--password-file",
        type=Path,
        help="Read password from a mode-0600 file instead of prompting",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=60.0,
        help="Per-request timeout in seconds (default: 60)",
    )

    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("probe", help="Check required API availability without login")
    commands.add_parser("shares", help="List accessible shared folders")

    list_parser = commands.add_parser("list", help="List a remote directory")
    list_parser.add_argument("remote_path", help="Path such as /share/folder")

    pull_parser = commands.add_parser("pull", help="Incrementally download a file/folder")
    pull_parser.add_argument(
        "--start-date",
        metavar="YYYYMMDD",
        help="Only pull files whose date is on or after this date",
    )
    pull_parser.add_argument(
        "--end-date",
        metavar="YYYYMMDD",
        help="Only pull files whose date is on or before this date",
    )
    pull_parser.add_argument(
        "--date-regex",
        default=DEFAULT_DATE_REGEX,
        help=(
            "Regex used to extract YYYYMMDD from file names; the first capture "
            f"group is used (default: {DEFAULT_DATE_REGEX})"
        ),
    )
    pull_parser.add_argument("remote_path", help="Path such as /share/folder")
    pull_parser.add_argument("local_path", type=Path, help="Local destination")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        client = SynologyClient(args.url, timeout=args.timeout)
        info = client.probe()
        if args.command == "probe":
            for name in sorted(info):
                details = info[name]
                print(
                    f"{name}: versions {details['minVersion']}-"
                    f"{details['maxVersion']}, path={details['path']}"
                )
            return 0

        password = (
            read_password_file(args.password_file)
            if args.password_file
            else getpass.getpass(f"DSM password for {args.user}: ")
        )
        try:
            client.login(args.user, password)
        except SynologyAPIError as exc:
            if exc.code != 403 or not sys.stdin.isatty():
                raise
            otp_code = input("DSM verification code: ").strip()
            client.login(args.user, password, otp_code=otp_code)
        finally:
            password = ""

        try:
            if args.command == "shares":
                for share in client.list_shares():
                    print(share["path"])
            elif args.command == "list":
                for item in client.list_dir(args.remote_path):
                    size, mtime = file_metadata(item)
                    kind = "dir " if item.get("isdir") else "file"
                    print(f"{kind}\t{size}\t{mtime}\t{item['path']}")
            elif args.command == "pull":
                start_date = (
                    parse_yyyymmdd(args.start_date, "--start-date")
                    if args.start_date
                    else None
                )
                end_date = (
                    parse_yyyymmdd(args.end_date, "--end-date")
                    if args.end_date
                    else None
                )
                if start_date is not None and end_date is not None and start_date > end_date:
                    raise ValueError("--start-date must not be after --end-date")
                downloaded, skipped = pull(
                    client,
                    args.remote_path,
                    args.local_path.expanduser(),
                    start_date=start_date,
                    end_date=end_date,
                    date_regex=compile_date_regex(args.date_regex),
                )
                print(f"Done: downloaded={downloaded}, skipped={skipped}")
            else:
                raise AssertionError(f"Unhandled command: {args.command}")
        finally:
            client.logout()
        return 0
    except (OSError, ValueError, SynologyError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
